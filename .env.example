# Copy to .env and adjust. Never commit .env. All values are read by the backend (pydantic-settings)
# or by docker compose. Secrets belong only in .env or your deployment's secret store.

# ---- core
# dev | test | prod (dev auto-migrates SQLite on startup)
NEXUS_ENV=dev
# or postgresql+psycopg://user:pass@host:5432/nexus
DATABASE_URL=sqlite:///./data/nexus.db
# thread (worker inside the API) | external (run app.workers.runner) | inline (tests)
JOBS_MODE=thread
CORS_ORIGINS=["http://localhost:3000"]
# true behind HTTPS
COOKIE_SECURE=false
SESSION_DAYS=14
LOG_LEVEL=INFO

# ---- docker compose only
POSTGRES_PASSWORD=change-me

# ---- web (frontend): where the Next.js proxy forwards /api/v1
API_ORIGIN=http://127.0.0.1:8000

# ---- limits
MAX_BACKTEST_BARS=300000
MAX_DISCOVERY_CANDIDATES=300
MAX_DISCOVERY_SECONDS=600
MAX_PARALLEL_JOBS_PER_USER=3
MAX_CSV_BYTES=5000000
EXPENSIVE_REQUESTS_PER_MINUTE=20
WEBHOOK_REQUESTS_PER_MINUTE=30

# ---- market data (public endpoints, no key)
BINANCE_BASE_URL=https://api.binance.com

# ---- AI research (optional). Leave AI_PROVIDER=none to disable.
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_TOOL_CALLS=8
AI_MAX_SECONDS=90
AI_MAX_RUNS_PER_DAY=50
